{
  "name": "bataryaopt",
  "compatibility_date": "2026-07-30",
  "main": "./worker/index.ts",
  "routes": [
    { "pattern": "bataryaopt.insposoft.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
